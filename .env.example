# === IBVAP Configuration ===
# Copy this file to .env and adjust values. Never commit the real .env.

APP_NAME=IBVAP
APP_ENV=development
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///./data/ibvap.db

# --- Storage ---
STORAGE_PATH=./data

# --- AI models (used starting Phase 3+) ---
YOLO_MODEL=models/yolo/yolo11n.pt
CONFIDENCE_THRESHOLD=0.45
PROCESS_FPS=10

# --- Night detection (Phase 5) ---
NIGHT_START=19:00
NIGHT_END=06:00
NIGHT_BRIGHTNESS_THRESHOLD=60

# --- Activity engine (Phase 5) ---
LOITERING_SECONDS=30

# --- ANPR (Phase 6) ---
ANPR_MIN_VEHICLE_WIDTH=80
ANPR_MIN_VEHICLE_HEIGHT=60
ANPR_MIN_CONFIDENCE=0.3

# --- Logging ---
LOG_LEVEL=INFO
